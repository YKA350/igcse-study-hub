rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dubai day number, the same as the website's server uses.
    function today() { return math.floor((request.time.toMillis() + 14400000) / 86400000); }
    // Only allow adding exactly 1 to today's count, up to the limit. Counts can never be lowered or reset.
    function plusOne(limit) {
      let d = request.resource.data;
      return d.keys().hasOnly(['day', 'n']) && d.day == today() && d.n <= limit
        && ((resource == null || resource.data.day != today()) ? d.n == 1 : d.n == resource.data.n + 1);
    }
    match /checks/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && plusOne(10);
    }
    match /totals/{name} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && name == 'all' && plusOne(900);
    }
  }
}
